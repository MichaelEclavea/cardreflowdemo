{
  "name": "cardreflowdemo",
  "version": "0.1.0",
  "homepage": "https://michaeleclavea.github.io/cardreflowdemo",
  "private": true,
  "dependencies": {
    "@fluentui/react-components": "^9.74.11",
    "@fluentui/react-icons": "^2.0.344",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "sass": "^1.93.2",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "eject": "react-scripts eject"
  },
  "jest": {
    "moduleNameMapper": {
      "^@fluentui/react-jsx-runtime/(jsx-runtime|jsx-dev-runtime)$": "<rootDir>/node_modules/@fluentui/react-jsx-runtime/lib-commonjs/$1.cjs",
      "^@fluentui/react-icons/(?:lib/)?providers$": "<rootDir>/node_modules/@fluentui/react-icons/lib-cjs/providers.cjs"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "description": "This project was bootstrapped with [Create React App](https://github.com/facebook/create-react-app).",
  "main": "index.js",
  "devDependencies": {
    "@types/jest": "^27.5.2",
    "@types/node": "^18.19.130",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "gh-pages": "^5.0.0",
    "typescript": "~4.9.5"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
